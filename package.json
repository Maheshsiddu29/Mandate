{
  "name": "mandate",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "workspaces": [
    "packages/kernel",
    "packages/registry",
    "packages/adapter-robinhood",
    "packages/router",
    "packages/jev"
  ],
  "scripts": {
    "audit:security": "npm audit --audit-level=high",
    "check": "npm run typecheck && npm test && npm run robinhood:fixtures:validate && npm run mainnet-replay:validate && npm run mainnet-routing:validate && npm run robinhood:cross-surface && npm run jev:fixtures:validate && npm run credentials:scan && npm run repository:junk",
    "corpus:generate": "node packages/kernel/test/support/generate-corpus.ts",
    "credentials:scan": "node scripts/scan-credentials.ts",
    "docs:generate": "node packages/kernel/test/support/generate-reason-codes-doc.ts && node packages/registry/test/support/generate-reason-codes-doc.ts",
    "generated:check": "npm run corpus:generate && npm run registry-corpus:generate && npm run docs:generate && npm run mainnet-replay:generate && npm run mainnet-routing:generate && npm run routing-simulation:generate && npm run jev:evaluate && git diff --exit-code -- corpus docs/reason-codes.md docs/registry-reason-codes.md",
    "jev:characterize": "node packages/jev/scripts/characterize.ts",
    "jev:evaluate": "node packages/jev/scripts/evaluate.ts",
    "jev:fixtures:validate": "node packages/jev/scripts/validate-fixtures.ts",
    "mainnet-replay:generate": "node packages/adapter-robinhood/scripts/generate-mainnet-replay.ts",
    "mainnet-replay:validate": "node --test packages/adapter-robinhood/test/mainnet-replay.test.ts",
    "mainnet-routing:generate": "node packages/router/scripts/generate-mainnet-routing.ts",
    "mainnet-routing:validate": "node --test packages/router/test/mainnet-routing.test.ts",
    "registry-corpus:generate": "node packages/registry/test/support/generate-corpus.ts",
    "repository:junk": "node scripts/check-repository-junk.ts",
    "robinhood:capture": "node packages/adapter-robinhood/scripts/capture-mainnet.ts",
    "robinhood:cross-surface": "node packages/adapter-robinhood/scripts/validate-cross-surface.ts",
    "robinhood:fixtures:validate": "node packages/adapter-robinhood/scripts/validate-fixtures.ts",
    "robinhood:live": "node packages/adapter-robinhood/scripts/live-check.ts",
    "router:benchmark": "node packages/router/scripts/benchmark.ts",
    "routing-simulation:generate": "node packages/router/scripts/generate-simulation-report.ts",
    "test": "node --test \"packages/**/test/*.test.ts\"",
    "typecheck": "tsc --project tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "22.20.2",
    "typescript": "5.9.3"
  }
}
