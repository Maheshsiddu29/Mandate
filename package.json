{
  "name": "mandate",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "workspaces": [
    "packages/kernel",
    "packages/registry",
    "packages/adapter-robinhood",
    "packages/router",
    "packages/jev",
    "packages/execution-gate",
    "packages/core",
    "packages/ledger",
    "packages/control",
    "packages/ledger-sqlite",
    "packages/perp-lighter",
    "packages/evm-robinhood",
    "packages/portfolio",
    "packages/judge-demo",
    "packages/live-agents",
    "packages/live-settlement"
  ],
  "scripts": {
    "audit:security": "npm audit --audit-level=high",
    "check": "npm run typecheck && npm test && npm run robinhood:fixtures:validate && npm run mainnet-replay:validate && npm run mainnet-routing:validate && npm run robinhood:cross-surface && npm run jev:fixtures:validate && npm run credentials:scan && npm run repository:junk",
    "contracts:build": "forge build --sizes",
    "contracts:fmt": "forge fmt --check contracts/src contracts/test contracts/script",
    "contracts:lint": "forge lint --deny notes",
    "contracts:slither": "slither .",
    "contracts:test": "npm run gate-corpus:generate && forge test",
    "core-corpus:generate": "node packages/core/test/support/generate-core-corpus.ts",
    "control-corpus:generate": "node packages/control/test/support/generate-control-corpus.ts",
    "portfolio-corpus:generate": "node packages/portfolio/test/support/generate-portfolio-corpus.ts",
    "control:benchmark": "node packages/control/scripts/benchmark.ts",
    "core:benchmark": "node packages/core/scripts/benchmark.ts",
    "corpus:generate": "node packages/kernel/test/support/generate-corpus.ts",
    "credentials:scan": "node scripts/scan-credentials.ts",
    "docs:generate": "node packages/kernel/test/support/generate-reason-codes-doc.ts && node packages/registry/test/support/generate-reason-codes-doc.ts",
    "gate-corpus:generate": "node packages/execution-gate/test/support/generate-gate-corpus.ts",
    "generated:check": "npm run corpus:generate && npm run registry-corpus:generate && npm run docs:generate && npm run mainnet-replay:generate && npm run mainnet-routing:generate && npm run routing-simulation:generate && npm run jev:evaluate && npm run gate-corpus:generate && npm run core-corpus:generate && npm run control-corpus:generate && npm run portfolio-corpus:generate && git diff --exit-code -- corpus docs/reason-codes.md docs/registry-reason-codes.md",
    "jev:benchmark": "node packages/jev/scripts/benchmark.ts",
    "jev:characterize": "node packages/jev/scripts/characterize.ts",
    "jev:evaluate": "node packages/jev/scripts/evaluate.ts",
    "jev:fixtures:validate": "node packages/jev/scripts/validate-fixtures.ts",
    "ledger:benchmark": "node packages/ledger/scripts/benchmark.ts",
    "mainnet-replay:generate": "node packages/adapter-robinhood/scripts/generate-mainnet-replay.ts",
    "mainnet-replay:validate": "node --test packages/adapter-robinhood/test/mainnet-replay.test.ts",
    "mainnet-routing:generate": "node packages/router/scripts/generate-mainnet-routing.ts",
    "mainnet-routing:validate": "node --test packages/router/test/mainnet-routing.test.ts",
    "registry-corpus:generate": "node packages/registry/test/support/generate-corpus.ts",
    "repository:junk": "node scripts/check-repository-junk.ts",
    "robinhood:capture": "node packages/adapter-robinhood/scripts/capture-mainnet.ts",
    "robinhood:cross-surface": "node packages/adapter-robinhood/scripts/validate-cross-surface.ts",
    "robinhood:fixtures:validate": "node packages/adapter-robinhood/scripts/validate-fixtures.ts",
    "robinhood:live": "node packages/adapter-robinhood/scripts/live-check.ts",
    "router:benchmark": "node packages/router/scripts/benchmark.ts",
    "routing-simulation:generate": "node packages/router/scripts/generate-simulation-report.ts",
    "test": "node --test \"packages/**/test/*.test.ts\"",
    "typecheck": "tsc --project tsconfig.json",
    "lighter:custody:build": "cd packages/perp-lighter/custody && go build -trimpath -o bin/lighter-custody .",
    "lighter:custody:check": "node packages/perp-lighter/scripts/custody-check.ts",
    "lighter:testnet:evidence": "node packages/perp-lighter/scripts/testnet-evidence.ts",
    "lighter:benchmark": "node packages/perp-lighter/scripts/benchmark.ts",
    "robinhood:testnet:deploy": "node packages/evm-robinhood/scripts/deploy.ts",
    "robinhood:testnet:demo": "node packages/evm-robinhood/scripts/demo.ts",
    "robinhood:testnet:verify": "node packages/evm-robinhood/scripts/verify.ts",
    "robinhood:v3:testnet:deploy": "node packages/evm-robinhood/scripts/deploy-delegated.ts",
    "robinhood:v3:testnet:verify": "node packages/evm-robinhood/scripts/verify-delegated.ts",
    "robinhood:v3:testnet:inventory": "node packages/evm-robinhood/scripts/v3-inventory.ts",
    "robinhood:v3:testnet:seed-inventory": "node packages/evm-robinhood/scripts/v3-seed-inventory.ts",
    "robinhood:v3:testnet:demo": "node packages/evm-robinhood/scripts/deploy-delegated.ts --dry-run",
    "portfolio:demo": "node packages/portfolio/scripts/demo.ts",
    "portfolio:benchmark": "node packages/portfolio/scripts/benchmark.ts",
    "demo:judge": "node packages/judge-demo/scripts/judge-demo.ts",
    "demo:judge:json": "node packages/judge-demo/scripts/judge-demo.ts --json",
    "web:demo:generate": "node scripts/generate-judge-demo-asset.ts",
    "web:demo:check": "node scripts/check-judge-demo-asset.ts",
    "agents:stub": "node packages/live-agents/scripts/live.ts --provider=stub",
    "agents:live": "node --env-file-if-exists=.env packages/live-agents/scripts/live.ts --provider=openai",
    "agents:live:json": "node --env-file-if-exists=.env packages/live-agents/scripts/live.ts --provider=openai --json",
    "agents:serve": "node --env-file-if-exists=.env packages/live-agents/scripts/serve.ts",
    "agents:lab": "node --env-file-if-exists=.env packages/live-settlement/scripts/lab.ts",
    "agents:live:testnet:dry-run": "node --env-file-if-exists=.env packages/live-settlement/scripts/testnet.ts --provider=openai --dry-run",
    "agents:live:testnet": "node --env-file-if-exists=.env packages/live-settlement/scripts/testnet.ts --provider=openai",
    "agents:rpc:smoke": "node --env-file-if-exists=.env packages/live-settlement/scripts/rpc-smoke.ts",
    "agents:settle:testnet": "node --env-file-if-exists=.env packages/live-settlement/scripts/settle.ts",
    "agents:settle:v2": "node --env-file-if-exists=.env packages/live-settlement/scripts/spine.ts"
  },
  "devDependencies": {
    "@openzeppelin/contracts": "5.6.1",
    "@types/node": "22.20.2",
    "typescript": "5.9.3"
  }
}
